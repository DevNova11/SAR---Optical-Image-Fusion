# Template only -- copy to secrets.toml for local testing (gitignored), or
# paste the equivalent into Streamlit Community Cloud's dashboard under
# App settings -> Secrets. Never commit real values from this file.
#
# How to get a GEE service account key:
#   1. In Google Cloud Console (the project registered for Earth Engine),
#      create a service account under IAM & Admin -> Service Accounts.
#   2. Grant it access to Earth Engine: either add it as a registered GEE
#      service account at https://code.earthengine.google.com/register
#      (Service accounts), or grant the "Earth Engine Resource Viewer" /
#      appropriate role on the Cloud project it's tied to.
#   3. Create a JSON key for that service account and download it.
#   4. Copy each field from the downloaded JSON into the table below --
#      field names below must match the JSON's keys exactly. The
#      private_key value already contains literal "\n" sequences in the
#      JSON; paste it as-is inside the quotes, TOML interprets \n as a
#      real newline the same way JSON does.

# Optional: set to false to hide "Custom Location" (live GEE pull) entirely
# on a public deployment, keeping only the pre-cached demo AOIs reachable.
# Defaults to true (Custom Location shown) if this key is absent. Must stay
# a top-level key -- TOML keys written after a [table] header below belong
# to that table, not the top level, so this line has to come first.
ALLOW_LIVE_GEE = true

[gee_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_DATA_HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-gcp-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
